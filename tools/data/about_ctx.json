ont-normal leading-[normal] left-[80px] text-[24px] text-[color:var(--text\\/primary,#20201e)] top-[376px] w-[600px]\" data-node-id=\"308:1211\">\n          Indiana University\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[normal] left-[880px] not-italic text-[#6d6a63] text-[15px] top-[381px] w-[480px]\" data-node-id=\"308:1212\">\n          UX Designer, Comet Lab \u00b7 2022\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[80px] top-[420px] w-[1280px]\" data-node-id=\"308:1213\" data-name=\"Rectangle\" />\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[normal] left-[80px] text-[24px] text-[color:var(--text\\/primary,#20201e)] top-[440px] w-[600px]\" data-node-id=\"308:1214\">\n          Tata Consultancy Services\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[normal] left-[80px] not-italic text-[#6d6a63] text-[14px] top-[470px] w-[600px]\" data-node-id=\"308:1215\">\n          (Client: National Securities Depository Ltd., NSDL)\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[normal] left-[880px] not-italic text-[#6d6a63] text-[15px] top-[445px] w-[480px]\" data-node-id=\"308:1216\">\n          Systems Engineer / UX Designer \u00b7 2019\u20132021\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[80px] top-[507px] w-[1280px]\" data-node-id=\"308:1197\" data-name=\"Rectangle\" />\n      </div>\n      <div className=\"h-[230px] overflow-clip relative shrink-0 w-[1440px]\" data-node-id=\"290:1267\" data-name=\"04 \u00b7 Education\">\n        <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[80px] not-italic text-[12px] text-[color:var(--text\\/secondary,#6d6a63)] top-0 