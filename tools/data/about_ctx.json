ndi98@gmail.com?subject=Hello%20Karthik%2C%20saw%20your%20portfolio&body=Hi%20Karthik%2C%0A%0AI%20came%20across%20your%20portfolio%20and%20would%20love%20to%20talk%20about%20a%20UX%20role%20%2F%20project%3A%0A%0A%5BA%20line%20about%20the%20role%2C%20team%20or%20problem%5D%0A%0ABest%2C%0A%5BYour%20name%5D\" data-node-id=\"I290:1200;321:1206\" target=\"_self\" data-name=\"Contact\">\n              <p className=\"[word-break:break-word] font-['Inter:Regular'] font-normal leading-[normal] not-italic relative shrink-0 text-[15px] text-[color:var(--text\\/secondary,#6d6a63)] text-left whitespace-nowrap\" data-node-id=\"I290:1200;321:1206;315:1262\">\n                Contact\n              </p>\n              <div className=\"h-[4px] relative shrink-0 w-[0.01px]\" data-node-id=\"I290:1200;321:1206;315:1263\" data-name=\"Draw mask\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgDrawMask} />\n              </div>\n            </a>\n          </div>\n        </div>\n        <div className=\"absolute h-[633px] left-0 top-[96px] w-[1440px]\" data-node-id=\"290:1209\" data-name=\"About \u2014 The quieter verse\">\n          <div className=\"absolute h-[500px] left-[80px] rounded-[4px] top-[40px] w-[420px]\" data-node-id=\"290:1210\" data-name=\"Portrait\">\n            <img alt=\"\" className=\"absolute inset-0 max-w-none object-cover pointer-events-none rounded-[4px] size-full\" src={imgPortrait} />\n          </div>\n          <div className=\"absolute h-[525.9px] left-[66.4px] top-[27.1px] w-[447.6px]\" data-node-id=\"290:1211\" data-name=\"Sketch frame\">\n            <div className=\"absolute inset-[-0.14%_-0.17%]\">\n              <img alt=\"\" className=\"block max-w-none size-full\" src={imgSketchFrame} />\n            </div>\n          </div>\n          <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[640px] not-italic text-[12px] text-[color:var(--text\\/secondary,#6d6a63)] top-[80px] tracking-[1.68px] whitespace-nowrap\" data-node-id=\"290:1212\">\n            ABOUT ME\n          </p>\n          <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[46px] left-[640px] text-[36px] text-[color:var(--text\\/primary,#20201e)] top-[112px] w-[680px]\" data-node-id=\"290:1213\">\n            A UX designer who turns complexity into clarity.\n          </p>\n          <div className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[0] left-[640px] not-italic text-[18px] text-[color:var(--text\\/secondary,#6d6a63)] top-[228px] w-[600px] whitespace-pre-wrap\" data-node-id=\"290:1214\">\n            <p className=\"leading-[29px] mb-0\">I design data-driven enterprise products, from the first workflow map to developer-ready specs. Over seven years I\u2019ve worked across logistics, enterprise software, healthcare, motorsport and fintech, and I hold an MS in Human-Computer Interaction from Indiana University.</p>\n            <p className=\"leading-[29px] mb-0\">\u200b</p>\n            <p className=\"leading-[29px]\">Outside design, I dance, take photos and travel. They keep me curious, and they keep the work in balance.</p>\n          </div>\n          <a className=\"[word-break:break-word] absolute block font-['Inter:Medium'] font-medium leading-[0] left-[640px] not-italic text-[15px] text-[color:var(--text\\/primary,#20201e)] top-[459px] whitespace-nowrap\" href=\"https://drive.google.com/file/d/1EbvfEBWWpgXVhEKMM-i15NeitrJVQAJg/view\" data-node-id=\"290:1215\" target=\"_blank\">\n            <p className=\"cursor-pointer leading-[normal] whitespace-pre\">{`Download my resume  \u2197`}</p>\n          </a>\n          <div className=\"absolute h-[1.244px] left-[638px] top-[481px] w-[181px]\" data-node-id=\"290:1216\" data-name=\"Link underline\">\n            <div className=\"absolute inset-[-60.27%_-0.41%]\">\n              <img alt=\"\" className=\"block max-w-none size-full\" src={imgLinkUnderline} />\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"h-[618px] relative shrink-0 w-[1440px]\" data-node-id=\"290:1217\" data-name=\"02 \u00b7 How I got here\">\n        <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[80px] not-italic text-[12px] text-[color:var(--text\\/secondary,#6d6a63)] top-[96px] tracking-[1.68px] whitespace-nowrap\" data-node-id=\"290:1218\">\n          HOW I GOT HERE\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[52px] left-[80px] text-[44px] text-[color:var(--text\\/primary,#20201e)] top-[128px] w-[460px]\" data-node-id=\"290:1219\">\n          Three moments that pulled me into UX.\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[27px] left-[80px] not-italic text-[17px] text-[color:var(--text\\/secondary,#6d6a63)] top-[260px] w-[420px]\" data-node-id=\"290:1220\">\n          None of them were planned. All of them still shape how I work.\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[640px] top-[108px] w-[720px]\" data-node-id=\"290:1221\" data-name=\"Rectangle\" />\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[34px] left-[680px] text-[26px] text-[color:var(--text\\/primary,#20201e)] top-[128px] w-[680px]\" data-node-id=\"290:1223\">\n          Many places, one lens\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[23px] left-[680px] not-italic text-[15px] text-[color:var(--accent\\/support,#5f6d56)] top-[172px] w-[640px]\" data-node-id=\"290:1224\">\n          From Hyderabad\u2019s pace of innovation to Tamil Nadu\u2019s culture and Mumbai\u2019s rush, every place I\u2019ve lived taught me to see a problem through someone else\u2019s eyes.\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[640px] top-[248px] w-[720px]\" data-node-id=\"290:1225\" data-name=\"Rectangle\" />\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[34px] left-[680px] text-[26px] text-[color:var(--text\\/primary,#20201e)] top-[268px] w-[680px]\" data-node-id=\"290:1227\">\n          The robotic arm\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[23px] left-[680px] not-italic text-[15px] text-[color:var(--accent\\/support,#5f6d56)] top-[312px] w-[640px]\" data-node-id=\"290:1228\">\n          Building a robotic arm in college, I saw that a machine can work perfectly and still be hard to use. That was the moment UX clicked.\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[640px] top-[388px] w-[720px]\" data-node-id=\"290:1229\" data-name=\"Rectangle\" />\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[34px] left-[680px] text-[26px] text-[color:var(--text\\/primary,#20201e)] top-[408px] w-[680px]\" data-node-id=\"290:1231\">\n          Design that earns trust\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[23px] left-[680px] not-italic text-[15px] text-[color:var(--accent\\/support,#5f6d56)] top-[452px] w-[640px]\" data-node-id=\"290:1232\">\n          At TCS, building fintech products for 50,000+ users showed me how intuitive design turns a working product into one people trust.\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[640.2px] not-italic text-[#a64b3c] text-[13px] top-[134px] whitespace-nowrap\" data-node-id=\"290:1237\">\n          01\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[639.8px] not-italic text-[#a64b3c] text-[13px] top-[274px] whitespace-nowrap\" data-node-id=\"290:1238\">\n          02\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[639.9px] not-italic text-[#a64b3c] text-[13px] top-[414px] whitespace-nowrap\" data-node-id=\"290:1239\">\n          03\n        </p>\n      </div>\n      <div className=\"h-[617px] relative shrink-0 w-[1440px]\" data-node-id=\"290:1240\" data-name=\"03 \u00b7 Experience\">\n        <p className=\"[word-break:break-word] absolute font-['Inter:Medium'] font-medium leading-[normal] left-[80px] not-italic text-[12px] text-[color:var(--text\\/secondary,#6d6a63)] top-[64px] tracking-[1.68px] whitespace-nowrap\" data-node-id=\"290:1241\">\n          EXPERIENCE\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[80px] top-[100px] w-[1280px]\" data-node-id=\"308:1198\" data-name=\"Rectangle\" />\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[normal] left-[80px] text-[24px] text-[color:var(--text\\/primary,#20201e)] top-[120px] w-[600px]\" data-node-id=\"308:1199\">\n          ProTrans International\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Inter:Regular'] font-normal leading-[normal] left-[880px] not-italic text-[#6d6a63] text-[15px] top-[125px] w-[480px]\" data-node-id=\"308:1200\">\n          UX/UI Designer \u00b7 2025\u2013now\n        </p>\n        <div className=\"absolute bg-[var(--border\\/subtle,#d8d0c3)] h-px left-[80px] top-[164px] w-[1280px]\" data-node-id=\"308:1201\" data-name=\"Rectangle\" />\n        <p className=\"[word-break:break-word] absolute font-['Newsreader:Regular'] font-normal leading-[normal] left-[80px] text-[24px] text-[color:var(--text\\/primary,#20201e)] top-[184px] w-[600px]\